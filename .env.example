# ============================================================
# +1AI — Free Open-Source AI Discord Bot Configuration
# ============================================================

# Discord Bot Credentials (https://discord.com/developers/applications)
DISCORD_TOKEN=your_discord_bot_token_here
DISCORD_CLIENT_ID=your_application_client_id_here
# Optional: set GUILD_ID for instant slash-command registration in one server
DISCORD_GUILD_ID=

# AI Provider: "gemini" (free tier), "groq" (free tier), or "ollama" (100% local)
AI_PROVIDER=gemini

# Option 1: Google Gemini API (Free at https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Option 2: Groq API (Free at https://console.groq.com/keys)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Option 3: Local Ollama (https://ollama.com)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Feature: Auto-Support (comma-separated channel IDs where the bot auto-replies without @mention)
# Outside these channels it only answers explicit @+1AI mentions (never @everyone/@here)
SUPPORT_CHANNEL_IDS=
SUPPORT_COOLDOWN_SECONDS=8

# Limits for AI calls
AI_TIMEOUT_MS=20000
# Per-user cooldown for /ask and /summarize
COMMAND_COOLDOWN_SECONDS=30

# Feature: /summarize (opt-in). Comma-separated channel IDs, or * for all channels.
# Note: with Gemini/Groq the selected messages and usernames are sent to that provider.
SUMMARIZE_CHANNEL_IDS=
SUMMARIZE_MAX_CHARS=12000

# Feature: AI Anti-Scam Shield
ANTI_SCAM_ENABLED=true
# review  = only report suspected scams to MOD_LOG_CHANNEL_ID (recommended to start)
# enforce = delete the message (+ optional timeout) and report the real outcome
ANTI_SCAM_MODE=review
ANTI_SCAM_MIN_CONFIDENCE=85
MOD_LOG_CHANNEL_ID=
ANTI_SCAM_TIMEOUT_MINUTES=10
